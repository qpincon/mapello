{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "checkJs": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/**/*",
    ".svelte-kit/ambient.d.ts",
    ".svelte-kit/non-ambient.d.ts"
  ],
  "exclude": [
    "node_modules/*",
    "./dist/**/*",
    "src/assets/layers/**/*",
    "src/examples/**/*",
    "src/svg/exportScripts/**/*"
  ]
}
